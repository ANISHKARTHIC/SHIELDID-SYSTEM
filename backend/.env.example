PROJECT_NAME="VenuePass Verification System API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pub_entry_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
# Or set DATABASE_URL directly (e.g. to point at RDS) — takes precedence
# over the POSTGRES_* fields above.
# DATABASE_URL=postgresql+psycopg2://user:pass@your-db.rds.amazonaws.com:5432/pub_entry_db

REDIS_URL=redis://localhost:6379/0

# --- Object storage ---
# Local dev (MinIO): set S3_ENDPOINT_URL + explicit keys.
S3_BUCKET_NAME=verification-images
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=changeme
S3_USE_PATH_STYLE=true
#
# AWS production: leave S3_ENDPOINT_URL / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
# UNSET. boto3 will pick up credentials automatically from the ECS task role
# or EC2 instance profile — only set S3_BUCKET_NAME and AWS_REGION:
# S3_BUCKET_NAME=venuepass-verification-images-prod
# AWS_REGION=us-east-1

# Internal URL for the AI microservice (ECS service discovery / internal
# ALB DNS name in AWS, not localhost).
AI_SERVICE_URL=http://localhost:8001

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
