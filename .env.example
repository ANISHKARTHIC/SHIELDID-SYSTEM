# Copy to .env and fill in real values before running:
#   docker compose up -d --build

POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pub_entry_db

# Real AWS S3 bucket for verification images (see README "AWS Deployment").
# The EC2 instance running docker-compose must have an instance profile
# attached with deploy/aws/s3-iam-policy.json — no access keys go in this file.
S3_BUCKET_NAME=venuepass-verification-images-prod
AWS_REGION=us-east-1

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# Public URL the frontend calls the backend on (baked into the frontend
# build — changing this requires a rebuild, not just a container restart).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
